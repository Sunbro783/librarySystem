<Window x:Class="LibraryClient.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Администратор — Библиотека" Height="700" Width="1150"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555577"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Ph" Text="{TemplateBinding Tag}"
                                           Foreground="#666699" FontSize="12"
                                           Margin="9,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsKeyboardFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Ph" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2E86AB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444466"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#333355"/>
            <Setter Property="RowBackground" Value="#2A2A3E"/>
            <Setter Property="AlternatingRowBackground" Value="#252538"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="RowHeight" Value="30"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="Foreground" Value="#AAB4C8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A4A6A"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8899BB"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🔑  Панель администратора"
                   FontSize="22" FontWeight="Bold"
                   Foreground="White" Margin="0,0,0,14"/>

        <TabControl Grid.Row="1" Background="#1E1E2E" BorderBrush="#444466">

            <!-- ══════════════════ КНИГИ ══════════════════ -->
            <TabItem Header="📚  Книги">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Add form -->
                    <Border Grid.Row="0" Background="#252538" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="➕  Добавить новую книгу"
                                       Foreground="#7EB8D4" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Labels row -->
                                <TextBlock Grid.Column="0" Text="Название книги *" Style="{StaticResource FieldLabel}" Margin="0,0,6,3"/>
                                <TextBlock Grid.Column="1" Text="Автор *"           Style="{StaticResource FieldLabel}" Margin="0,0,6,3"/>
                                <TextBlock Grid.Column="2" Text="ISBN"              Style="{StaticResource FieldLabel}" Margin="0,0,6,3"/>
                                <TextBlock Grid.Column="3" Text="Год"               Style="{StaticResource FieldLabel}" Margin="0,0,6,3"/>
                                <TextBlock Grid.Column="4" Text="Жанр"              Style="{StaticResource FieldLabel}" Margin="0,0,6,3"/>
                                <TextBlock Grid.Column="5" Text="Всего копий"       Style="{StaticResource FieldLabel}" Margin="0,0,6,3"/>
                                <TextBlock Grid.Column="6" Text="Доступно"          Style="{StaticResource FieldLabel}" Margin="0,0,6,3"/>
                            </Grid>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="BookTitle"  Grid.Column="0" Margin="0,0,6,0" Tag="Пр.: Война и мир"/>
                                <TextBox x:Name="BookAuthor" Grid.Column="1" Margin="0,0,6,0" Tag="Пр.: Толстой"/>
                                <TextBox x:Name="BookISBN"   Grid.Column="2" Margin="0,0,6,0" Tag="978-5-..."/>
                                <TextBox x:Name="BookYear"   Grid.Column="3" Margin="0,0,6,0" Tag="2024"/>
                                <TextBox x:Name="BookGenre"  Grid.Column="4" Margin="0,0,6,0" Tag="Роман"/>
                                <TextBox x:Name="BookTotal"  Grid.Column="5" Margin="0,0,6,0" Tag="5"/>
                                <TextBox x:Name="BookAvail"  Grid.Column="6" Margin="0,0,6,0" Tag="5"/>
                                <Button  Grid.Column="7" Content="➕ Добавить"
                                         Background="#27AE60" Click="AddBook_Click" Padding="12,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="🔄  Обновить" Click="LoadBooks_Click" Margin="0,0,8,0"/>
                        <Button Content="🗑  Удалить выбранную" Background="#E63946" Click="DeleteBook_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="BooksGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"       Binding="{Binding Id}"             Width="50"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Title}"           Width="*"/>
                            <DataGridTextColumn Header="Автор"    Binding="{Binding Author}"          Width="150"/>
                            <DataGridTextColumn Header="ISBN"     Binding="{Binding ISBN}"            Width="140"/>
                            <DataGridTextColumn Header="Год"      Binding="{Binding PublicationYear}" Width="60"/>
                            <DataGridTextColumn Header="Жанр"     Binding="{Binding Genre}"           Width="100"/>
                            <DataGridTextColumn Header="Всего"    Binding="{Binding TotalCopies}"     Width="65"/>
                            <DataGridTextColumn Header="Доступно" Binding="{Binding AvailableCopies}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ══════════════════ ЧИТАТЕЛИ ══════════════════ -->
            <TabItem Header="👥  Читатели">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#252538" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="➕  Добавить нового читателя"
                                       Foreground="#7EB8D4" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ФИО читателя *"       Style="{StaticResource FieldLabel}" Margin="0,0,6,3"/>
                                <TextBlock Grid.Column="1" Text="Email"                Style="{StaticResource FieldLabel}" Margin="0,0,6,3"/>
                                <TextBlock Grid.Column="2" Text="Телефон"              Style="{StaticResource FieldLabel}" Margin="0,0,6,3"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ReaderName"  Grid.Column="0" Margin="0,0,6,0" Tag="Иванов Иван Иванович"/>
                                <TextBox x:Name="ReaderEmail" Grid.Column="1" Margin="0,0,6,0" Tag="example@mail.ru"/>
                                <TextBox x:Name="ReaderPhone" Grid.Column="2" Margin="0,0,6,0" Tag="79001234567"/>
                                <Button  Grid.Column="3" Content="➕ Добавить"
                                         Background="#27AE60" Click="AddReader_Click" Padding="12,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="🔄  Обновить" Click="LoadReaders_Click" Margin="0,0,8,0"/>
                        <Button Content="🗑  Удалить выбранного" Background="#E63946" Click="DeleteReader_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="ReadersGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"               Binding="{Binding Id}"                                        Width="50"/>
                            <DataGridTextColumn Header="ФИО"              Binding="{Binding FullName}"                                  Width="*"/>
                            <DataGridTextColumn Header="Email"             Binding="{Binding Email}"                                     Width="200"/>
                            <DataGridTextColumn Header="Телефон"           Binding="{Binding Phone}"                                     Width="140"/>
                            <DataGridTextColumn Header="Дата регистрации"  Binding="{Binding RegistrationDate, StringFormat=dd.MM.yyyy}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ══════════════════ ВЫДАЧИ ══════════════════ -->
            <TabItem Header="📋  Выдачи">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="🔄  Обновить" Click="LoadLoans_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="LoansGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID выдачи"  Binding="{Binding Id}"                                  Width="75"/>
                            <DataGridTextColumn Header="Книга"      Binding="{Binding BookTitle}"                            Width="*"/>
                            <DataGridTextColumn Header="Читатель"   Binding="{Binding ReaderName}"                          Width="180"/>
                            <DataGridTextColumn Header="Выдана"     Binding="{Binding LoanDate, StringFormat=dd.MM.yyyy}"   Width="90"/>
                            <DataGridTextColumn Header="Срок до"    Binding="{Binding DueDate, StringFormat=dd.MM.yyyy}"    Width="90"/>
                            <DataGridTextColumn Header="Возвращена" Binding="{Binding ReturnDate, StringFormat=dd.MM.yyyy}" Width="105"/>
                            <DataGridTextColumn Header="Статус"     Binding="{Binding Status}"                              Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
